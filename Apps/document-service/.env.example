# Server Configuration
PORT=3080
HOST=0.0.0.0

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
LOG_REQUESTS=true

# Authentication — the renderer verifies the caller's JWT but does no
# membership lookup: it holds no tenant data of its own.
AUTH_JWT_SECRET=local-dev-secret
AUTH_JWT_ISSUER=tartware-core
AUTH_JWT_AUDIENCE=tartware

# Rendering limits
DOCUMENT_MAX_PAYLOAD_BYTES=2097152
DOCUMENT_MAX_TABLE_ROWS=5000
DOCUMENT_TIME_ZONE=UTC
