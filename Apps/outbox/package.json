{
  "name": "@tartware/outbox",
  "version": "0.1.0",
  "description": "Shared transactional outbox utilities for Tartware services",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc -q && tsc --project tsconfig.json --emitDeclarationOnly",
    "lint": "eslint --ext .ts src",
    "biome": "biome check src",
    "knip": "knip --tsConfig tsconfig.json",
    "clean": "rm -rf dist dist-tests *.tsbuildinfo",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build:tests": "tsc --project tsconfig.tests.json",
    "test": "npm run build:tests && node --test dist-tests/tests/*.js"
  },
  "dependencies": {
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  }
}
